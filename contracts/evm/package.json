{
  "name": "@ai-arena/contracts-evm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network zerog-testnet",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:arena:testnet": "hardhat run scripts/deploy-arena-economy.ts --network zerog-testnet",
    "deploy:arena:mainnet": "hardhat run scripts/deploy-arena-economy.ts --network zerog-mainnet",
    "redeploy:arena:permit:mainnet": "hardhat run scripts/redeploy-arena-permit.ts --network zerog-mainnet",
    "deploy:creator:testnet": "hardhat run scripts/deploy-creator-studio.ts --network zerog-testnet",
    "deploy:creator:mainnet": "hardhat run scripts/deploy-creator-studio.ts --network zerog-mainnet",
    "verify:zerog": "hardhat verify --network zerog-mainnet",
    "verify:base:addresses": "hardhat run scripts/verify-base-contracts.ts --network base",
    "deploy:a2a:base": "hardhat run scripts/deploy-a2a-base.ts --network base",
    "node:base-fork": "hardhat node --fork ${BASE_RPC_URL:-https://mainnet.base.org}",
    "grant:a2a:roles": "hardhat run scripts/grant-a2a-roles.ts --network base",
    "check:a2a:deploy": "hardhat run scripts/check-deploy-state.ts --network base",
    "verify:a2a:base": "hardhat run scripts/verify-etherscan-v2.ts --network base",
    "rotate:a2a:role": "hardhat run scripts/rotate-a2a-role.ts --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "hardhat": "^2.22.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "ethers": "^6.11.0"
  }
}
